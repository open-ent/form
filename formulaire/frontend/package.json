    "lint-staged": "14.0.1",
    "nx": "19.6.0",
    "prettier": "3.0.3",
    "sass": "1.69.5",
    "typescript": "5.2.2",
    "typescript-eslint": "^8.8.1",
    "vite": "4.4.11",
    "vite-tsconfig-paths": "4.2.1",
    "vitest": "0.34.6",
    "vitest-dom": "0.1.1"
  },
  "pnpm": {
    "overrides": {
      "@tiptap/extension-horizontal-rule": "2.11.0"
    }
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": "18 | 20 | >=22"
  },
  "nx": {}
