{
  "name": "Formulaire",
  "version": "2.0-dev",
  "description": "Formulaire",
  "homepage": "https://github.com/OPEN-ENT-NG/form#readme",
  "bugs": {
    "url": "https://github.com/OPEN-ENT-NG/form/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OPEN-ENT-NG/form.git"
  },
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "clean": "concurrently \"pnpm:clean:*\"",
    "clean:dist": "rm -rf dist",
    "clean:lighthouse": "rm -rf .lighthouseci",
    "clean:modules": "rm -rf node_modules",
    "clean:package": "rm -f pnpm-lock.yaml && rm -f package.json",
    "dev": "vite",
    "test": "vitest",
    "fix": "eslint --fix .",
    "check-types": "tsc --noEmit",
    "format": "pnpm format:check && pnpm format:write",
    "format:check": "npx prettier --check .",
    "format:write": "npx prettier --write .",
    "preinstall": "npx only-allow pnpm",
    "lighthouse": "pnpm clean:lighthouse && lhci autorun",
    "lint": "eslint .",
    "pre-commit": "lint-staged",
    "prepare": "cd .. && husky install frontend/.husky",
    "preview": "vite preview",
    "tsc": "tsc"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "pnpm run format",
      "pnpm run lint"
    ]
  },
  "dependencies": {
    "@cgi-learning-hub/icons": "1.13.0",
    "@cgi-learning-hub/theme": "1.13.0",
    "@cgi-learning-hub/ui": "1.13.0",
