auto-install-peers=true
strict-peer-dependencies=false
@tiptap-pro:registry=https://registry.tiptap.dev/
//registry.tiptap.dev/:_authToken=${TIPTAP_PRO_TOKEN}

# Fork openent publié sur GitHub Packages (scope @open-ent).
# En CI: NODE_AUTH_TOKEN = GITHUB_TOKEN. En local: PAT classic read:packages.
@open-ent:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
